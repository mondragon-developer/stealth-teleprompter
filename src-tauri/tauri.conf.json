{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Script",
  "version": "0.1.0",
  "identifier": "com.jmond.screenscript",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Screen Script",
        "width": 860,
        "height": 340,
        "minWidth": 420,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzQUI2OUFENzgxOUQ5NApSV1NVbllIWG1yWTZBdnJjMDVqQ1g5dWs1eE9tczVmV3dYUFNFWU5uUDNwYTV3cmEyV2RhZFNDTgo=",
      "endpoints": [
        "https://github.com/mondragon-developer/screen-script/releases/latest/download/latest.json"
      ]
    }
  }
}
